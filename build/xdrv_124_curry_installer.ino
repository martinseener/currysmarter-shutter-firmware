#if defined(USE_CURRY_SHUTTER) && defined(USE_UFILESYS)
/*********************************************************************************************\
 * Currysmarter EU-CL02 roller shutter (ESP32-C3 + Tuya MCU)
 *
 * An OTA image only replaces the app partition, never the file system, so the
 * Berry driver cannot simply be part of the image. Instead it is embedded here
 * and written to the file system once per firmware build, before Berry runs
 * autoexec.be (first loop tick):
 *   /curry_shutter.be   replaced by the embedded version
 *   /autoexec.be        created, or the load() line appended if missing
 *   /curry_shutter.ver  build marker; write "off" into it to stop the installer
 *
 * After that the files belong to the user: edits or a removed load() line are
 * kept until a firmware with a different driver version is installed.
 * https://github.com/martinseener/currysmarter-shutter-firmware
\*********************************************************************************************/

#define XDRV_124                  124

#include "curry_berry_files.h"     // generated by build/embed_berry.py

const char kCurryDriverFile[] PROGMEM = "/curry_shutter.be";
const char kCurryAutoexecFile[] PROGMEM = "/autoexec.be";
const char kCurryMarkerFile[] PROGMEM = "/curry_shutter.ver";
const char kCurryLoadLine[] PROGMEM = "\nload(\"/curry_shutter.be\")\n";

bool CurryFileEquals(const char *fname, const char *data, uint32_t len) {
  if (TfsFileSize(fname) != len) { return false; }
  uint8_t *buf = (uint8_t*)malloc(len);
  if (!buf) { return false; }
  bool equal = TfsLoadFile(fname, buf, len) && (0 == memcmp(buf, data, len));
  free(buf);
  return equal;
}

// Adds the load() line to an existing autoexec.be unless it already loads the driver
bool CurryAutoexecAddLoad(void) {
  size_t len = TfsFileSize(kCurryAutoexecFile);
  size_t add = strlen(kCurryLoadLine);
  char *buf = (char*)calloc(len + add +1, 1);
  if (!buf) { return false; }
  bool ok = TfsLoadFile(kCurryAutoexecFile, (uint8_t*)buf, len);
  if (ok && !strstr(buf, "curry_shutter.be")) {
    strcat(buf, kCurryLoadLine);
    ok = TfsSaveFile(kCurryAutoexecFile, (const uint8_t*)buf, len + add);
    AddLog(LOG_LEVEL_INFO, PSTR("CRY: load line appended to %s"), kCurryAutoexecFile);
  }
  free(buf);
  return ok;
}

void CurryInstall(void) {
  char marker[32] = { 0 };
  if (TfsLoadFile(kCurryMarkerFile, (uint8_t*)marker, sizeof(marker) -1)) {
    char *nl = strpbrk(marker, "\r\n ");
    if (nl) { *nl = '\0'; }
    if (!strcmp(marker, "off")) {
      AddLog(LOG_LEVEL_INFO, PSTR("CRY: installer off (%s)"), kCurryMarkerFile);
      return;
    }
    if (!strcmp(marker, CURRY_BERRY_VERSION)) { return; }  // already installed by this build
  }

  bool ok = true;
  if (!CurryFileEquals(kCurryDriverFile, curry_shutter_be, sizeof(curry_shutter_be) -1)) {
    ok &= TfsSaveFile(kCurryDriverFile, (const uint8_t*)curry_shutter_be, sizeof(curry_shutter_be) -1);
    AddLog(LOG_LEVEL_INFO, PSTR("CRY: %s written"), kCurryDriverFile);
  }
  if (!TfsFileExists(kCurryAutoexecFile)) {
    ok &= TfsSaveFile(kCurryAutoexecFile, (const uint8_t*)autoexec_be, sizeof(autoexec_be) -1);
    AddLog(LOG_LEVEL_INFO, PSTR("CRY: %s written"), kCurryAutoexecFile);
  } else {
    ok &= CurryAutoexecAddLoad();
  }
  if (ok) {
    TfsSaveFile(kCurryMarkerFile, (const uint8_t*)CURRY_BERRY_VERSION, strlen(CURRY_BERRY_VERSION));
    AddLog(LOG_LEVEL_INFO, PSTR("CRY: Berry driver %s installed"), CURRY_BERRY_VERSION);
  } else {
    AddLog(LOG_LEVEL_ERROR, PSTR("CRY: Berry driver install failed"));
  }
}

/*********************************************************************************************\
 * Interface
\*********************************************************************************************/

bool Xdrv124(uint32_t function) {
  if (FUNC_INIT == function) {      // file system is mounted, autoexec.be runs later
    CurryInstall();
  }
  return false;
}

#endif  // USE_CURRY_SHUTTER && USE_UFILESYS
